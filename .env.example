CONSULTANT_PROVIDER=disabled
# Public HTTPS origin for Coolify's reverse proxy. Omit for local development.
# PUBLIC_ORIGIN=https://demo.lider-massiv.ru
CONSULTANT_DAILY_LIMIT=20
# Runtime only. Never prefix secrets with VITE_ or commit actual values.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5.1
# Alternative provider: n8n. Assign Yandex credentials inside n8n instead.
CONSULTANT_N8N_URL=
CONSULTANT_N8N_TOKEN=

ADMIN_LOGIN=
ADMIN_PASSWORD_HASH=
